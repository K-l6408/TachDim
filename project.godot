; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tachyon Dimensions"
config/tags=PackedStringArray("idle")
run/main_scene="res://UI/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/image="res://images/loading/default.png"
config/icon="res://icon.svg"

[autoload]

Globals="*res://globals.gd"
Currencies="*res://internal/currencies.gd"
TachyonDims="*res://internal/dimensions/tachyons.gd"
Permanence="*res://internal/permanence.gd"
Autobuyers="*res://internal/autobuyers.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PermaDims="*res://internal/dimensions/permanence.gd"
Hotkeys="*res://internal/hotkeys.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/size/transparent=true
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=0

[editor]

movie_writer/movie_file="/home/ale/Desktop/TachDym.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[gui]

timers/tooltip_delay_sec=999.0
theme/custom="res://themes/Dark.tres"

[importer_defaults]

dialogue_manager_compiler_14={
"defaults": true
}

